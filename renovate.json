{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "pinDigests": true,
  "docker-compose": {
    "enabled": true,
    "pinDigests": true
  },
  "packageRules": [
    {
      "description": "Group docker-compose image updates into a single PR",
      "matchManagers": ["docker-compose"],
      "groupName": "docker-compose images"
    },
    {
      "description": "Auto-merge digest-only updates for pinned images",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "automerge": true
    }
  ]
}
